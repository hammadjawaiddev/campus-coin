# ─────────────────────────────────────────────────────────────────────────────
# Campus Coin — backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (MongoDB / MongoDB Atlas) ------------------------------------------
# Local:  mongodb://127.0.0.1:27017/campuscoin
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/campuscoin?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/campuscoin

# Authentication --------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
RESET_TOKEN_TTL_MINUTES=30

# URLs & CORS -----------------------------------------------------------------
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
# Extra allowed origins, comma separated (preview URLs, staging, production SPA)
EXTRA_ORIGINS=

# Email (optional) — used for password reset + monthly digest -----------------
# Without these the API still works: reset links are written to the server log.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Campus Coin <no-reply@campuscoin.app>"

# AI assistant (optional) — any OpenAI-compatible endpoint --------------------
# Without a key Campus Coin falls back to its built-in rule engine and
# analytics-written insights. No feature is broken when this is empty.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# Limits ----------------------------------------------------------------------
MAX_CSV_SIZE_MB=5
MAX_CSV_ROWS=2000
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=25

# Seed / demo credentials -----------------------------------------------------
SEED_DEMO_PASSWORD=CampusCoin123
SEED_ADMIN_PASSWORD=AdminCoin123
